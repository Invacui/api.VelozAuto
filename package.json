{
  "name": "api-vehicle-marketplace",
  "version": "1.0.0",
  "description": "Backend API for VehicleMarket - Indian used vehicle marketplace (buy & sell cars, commercial vehicles, two-wheelers, caravans)",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.js",
    "build:check": "tsc --noEmit",
    "dev:start": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "dev": "npm run dev:start",
    "start": "node dist/server.js",
    "prod:start": "cross-env NODE_ENV=production node dist/server.js",
    "prod": "npm run build && npm run prod:start",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "seed": "npm run seed:master && npm run seed:admin && npm run seed:vehicles && npm run seed:content",
    "seed:master": "cross-env NODE_ENV=development ts-node --transpile-only -r tsconfig-paths/register src/seeds/master.seed.ts",
    "seed:admin": "cross-env NODE_ENV=development ts-node --transpile-only -r tsconfig-paths/register src/seeds/admin.seed.ts",
    "seed:vehicles": "cross-env NODE_ENV=development ts-node --transpile-only -r tsconfig-paths/register src/seeds/vehicles.seed.ts",
    "seed:content": "cross-env NODE_ENV=development ts-node --transpile-only -r tsconfig-paths/register src/seeds/content.seed.ts",
    "docs:check": "cross-env NODE_ENV=development ts-node --transpile-only -r tsconfig-paths/register scripts/checkOpenapi.ts",
    "lint": "eslint src/**/*.ts",
    "docs:generate": "node scripts/generateOpenapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@upstash/redis": "^1.38.0",
    "@zavudev/sdk": "^0.59.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.3.2",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.0",
    "@types/supertest": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "cross-env": "^10.0.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0"
  }
}
