JWT_REFRESH_EXPIRES=7d

# Session
SESSION_SECRET=vm-dev-session-secret

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (Resend) — leave empty to use the console stub
RESEND_API_KEY=
RESEND_DEFAULT_SENDER=VehicleMarket <noreply@vehiclemarket.example>

# Google Sign-In (web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=214937809065-htljnocqq1o5nch8i43lg8rovfidhpoc.apps.googleusercontent.com

# WhatsApp (Meta WhatsApp Cloud API) - leave empty to log messages instead of sending them
# Set these for Meta official API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_REQUEST_ACK=

# Legacy Zavu vars (kept for backward compatibility)
ZAVUDEV_API_KEY=
ZAVUDEV_SENDER_ID=
ZAVUDEV_TEMPLATE_REQUEST_ACK=
ZAVUDEV_TEMPLATE_PHONE_OTP=otp

# Storage
STORAGE_MODE=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=vehicle-marketplace
S3_PUBLIC_URL=
LOCAL_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
MAX_IMAGES_PER_VEHICLE=15

# Logging
LOG_LEVEL=debug
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Bcrypt
BCRYPT_ROUNDS=10

# Admin fallback email
ADMIN_EMAIL=admin@vehiclemarket.in
