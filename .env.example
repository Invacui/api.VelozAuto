# ---------------------------------------------------------------------------
# VehicleMarket backend — environment template.
# Copy to environment/development.env and fill in real values.
#   cp .env.example environment/development.env
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost
FRONTEND_URL=http://localhost:3000

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017
DB_NAME=vehicle-marketplace

# Redis (OPTIONAL — an in-memory store with TTL is used when left unset)
# Works with Upstash: REDIS_URL=https://xxx.upstash.io  REDIS_TOKEN=xxx
REDIS_URL=
REDIS_TOKEN=

# JWT — CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Session
SESSION_SECRET=

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (Resend) — leave empty to use the console-log stub in development
RESEND_API_KEY=
RESEND_DEFAULT_SENDER=VehicleMarket <noreply@vehiclemarket.example>

# Google Sign-In (web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Zavu (WhatsApp) - leave empty to log messages instead of sending them in development
ZAVUDEV_API_KEY=
ZAVUDEV_SENDER_ID=
ZAVUDEV_TEMPLATE_REQUEST_ACK=
ZAVUDEV_TEMPLATE_PHONE_OTP=

# Storage — "local" writes to LOCAL_UPLOAD_PATH; "s3" uses the S3_* values
STORAGE_MODE=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=vehicle-marketplace
S3_PUBLIC_URL=
LOCAL_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
MAX_IMAGES_PER_VEHICLE=15

# Logging
LOG_LEVEL=debug
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Bcrypt cost
BCRYPT_ROUNDS=10

# An extra admin account created by `npm run seed:admin` (optional)
ADMIN_EMAIL=
